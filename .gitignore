# Never commit secrets or machine state
*.key
*.pem
*.token
.env
*.secret
# OmniGlyph runtime state (history, notification prefs)
.config/omniglyph/settings.json
# Generated at runtime
*.log
/backups/
sddm-theme/kessel/background.*
# hyprmoncfg writes its layout next to the Hyprland config (~/.config/hypr → this repo)
.config/hypr/hyprmoncfg-monitors.lua
.config/hypr/hyprmoncfg-monitors.conf
