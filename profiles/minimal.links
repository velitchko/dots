# SPDX-License-Identifier: GPL-3.0-or-later
# Config links for the "minimal" profile: <repo path>  <live path relative to $HOME>
# (~/Scripts → scripts/: install, update, uninstall, backup, gen-shortcuts)
# Each live path becomes a symlink into this repo. Anything already there is
# moved to ~/.local/state/dot-files/backups/<timestamp>/ first.
.config/hypr                 .config/hypr
.config/kitty/kitty.conf     .config/kitty/kitty.conf
.config/fuzzel/fuzzel.ini    .config/fuzzel/fuzzel.ini
.config/dunst/dunstrc        .config/dunst/dunstrc
.config/fish/config.fish     .config/fish/config.fish
.config/fish/conf.d/aliases.fish   .config/fish/conf.d/aliases.fish
.config/fish/conf.d/theme.fish     .config/fish/conf.d/theme.fish
.config/fish/functions/starship_transient_prompt_func.fish  .config/fish/functions/starship_transient_prompt_func.fish
.config/starship.toml        .config/starship.toml
.config/nvim                 .config/nvim
.config/fontconfig/fonts.conf .config/fontconfig/fonts.conf
.config/gtk-3.0/settings.ini .config/gtk-3.0/settings.ini
.config/gtk-4.0/settings.ini .config/gtk-4.0/settings.ini
.config/quickshell/kessel    .config/quickshell/kessel
.config/quickshell/kessel-lock .config/quickshell/kessel-lock
.config/omniglyph/config.toml .config/omniglyph/config.toml
scripts                      Scripts
